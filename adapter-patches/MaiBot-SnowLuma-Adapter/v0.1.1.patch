+    async def _handle_auto_poke_back(
+        self, payload: QQPayloadDict, self_id: str, settings: QQPluginSettings
+    ) -> bool:
+        """直接回戳真正戳到本账号的发起者，消费通知而不启动 Planner。"""
+        if not settings.notice.enabled or not settings.notice.auto_poke_back:
+            return False
+        if payload.get("notice_type") != "notify" or payload.get("sub_type") != "poke":
+            return False
+        runtime = self._require_runtime()
+        sender_id = str(payload.get("user_id") or "").strip()
+        target_id = str(payload.get("target_id") or "").strip()
+        if not self_id or self_id != runtime.runtime_state.account_id:
+            return False
+        # 回戳自身产生的通知也由此消费，避免再交给 Planner 形成文字回复或回戳循环。
+        if sender_id == self_id:
+            return True
+        if not sender_id or target_id != self_id:
+            return False
+        group_id = str(payload.get("group_id") or "").strip()
+        await runtime.query_service.send_poke(
+            user_id=int(sender_id), group_id=int(group_id) if group_id else None
+        )
+        self._logger.info("戳一戳自动回戳成功")
+        return True
